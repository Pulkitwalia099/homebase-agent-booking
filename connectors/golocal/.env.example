# Run npm run setup to generate the three independent secrets.
PORT=8787
HOST=127.0.0.1
PUBLIC_BASE_URL=http://localhost:8787
MCP_BEARER_TOKEN=
ADMIN_TOKEN=
DATA_ENCRYPTION_KEY=
DATA_DIR=.data
# demo: simulated bookings; jobber: account reads/test-client write; housecall: bound test reads, optional synthetic $0 jobs.
BACKEND=demo
# Optional Dots/ChatGPT OAuth. Separate grants: golocal:demo or golocal:housecall-test; never automatically expand access.
ENABLE_DOTS_OAUTH=false
# Optional private Muse test credential. Issue separately after approval; exact origin/company, at most one day.
MUSE_TEST_BEARER_TOKEN=
MUSE_TEST_COMPANY_ID=
MUSE_TEST_PUBLIC_BASE_URL=
MUSE_TEST_TOKEN_EXPIRES_AT=
# Optional reviewed hosted pilot: persistent mount, independent verifier and revocable no-daily-expiry access.
GOLOCAL_HOSTED=false
GOLOCAL_HOSTED_KEY_ENABLED=false
GOLOCAL_HOSTED_KEY_SHA256=
GOLOCAL_HOSTED_COMPANY_ID=
# One-time encrypted Housecall-only migration. Remove after durable disk verification; never commit.
GOLOCAL_BOOTSTRAP_STATE_BASE64=
# Housecall Pro private free-trial test ONLY. Bind exact test company ID. Full-access key required only for controlled test writes.
HOUSECALL_API_KEY=
HOUSECALL_TEST_COMPANY_ID=
HOUSECALL_TEST_OWNER_ID=
ENABLE_HOUSECALL_TEST_WRITES=false
# Jobber developer test account ONLY. Must match the OAuth-authorized account ID.
JOBBER_TEST_ACCOUNT_ID=
JOBBER_CLIENT_ID=
JOBBER_CLIENT_SECRET=
JOBBER_GRAPHQL_VERSION=2026-09-25
ENABLE_JOBBER_TEST_WRITES=false
# Exact origins permitted for browser-originated MCP requests; no wildcard.
ALLOWED_ORIGINS=
